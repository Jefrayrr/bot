{
  "name": "linkedin-job-bot",
  "version": "1.0.0",
  "description": "Professional LinkedIn Job Bot - Automatically search, analyze, score, and track job opportunities",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "api": "node dist/api/server.js",
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sparticuz/chromium": "^149.0.0",
    "dotenv": "^16.4.7",
    "puppeteer-core": "^24.43.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "puppeteer-core@24.43.1": true,
    "@sparticuz/chromium@149.0.0": true,
    "esbuild@0.28.1": true
  }
}
